# Copy to .env (never commit .env). All values are optional.

# Host port published on 127.0.0.1 by docker compose
APP_PORT=5000

# Timezone used to decide what is "due today"
TZ=UTC

# Gunicorn tuning (defaults suit a 1 GB instance)
# WEB_CONCURRENCY=1
# GUNICORN_THREADS=4

# Local (non-Docker) runs only; Docker sets this to the /data volume
# DATABASE_URL=sqlite:///data/tasks.db
